{
  "name": "medsvyaz24",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx server/local.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/local.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node --import tsx scripts/verify.ts",
    "calculate": "node --import tsx scripts/calculate.ts",
    "geo:build": "python scripts/build_geodata.py",
    "examples:build": "python scripts/build_examples.py",
    "pilot:build": "python scripts/build_pilot.py",
    "synthetic:build": "node --import tsx scripts/build_synthetic.ts",
    "calculate:final": "npm run calculate && python3 scripts/verify_v5.py",
    "submission": "python3 scripts/prepare_submission.py",
    "passport": "node --import tsx scripts/passport-data.ts && node scripts/build-passport.mjs",
    "check:lite": "node scripts/check-lite.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "lucide-react": "^0.468.0",
    "leaflet": "1.9.4",
    "katex": "^0.19.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/geojson": "^7946.0.16",
    "@types/katex": "^0.16.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.0",
    "tsx": "^4.20.0",
    "esbuild": "^0.25.0",
    "@playwright/test": "^1.56.0"
  }
}
